{
  "name": "knife-terminal",
  "version": "0.8.0",
  "description": "CW&T's own terminal. Basic, with tabs.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty",
    "build": "npm run build-helper && electron-packager . \"Knife Terminal\" --platform=darwin --arch=arm64 --icon=build/icon.icns --out=dist --overwrite --asar=false --app-bundle-id=com.cwandt.knifeterminal --extend-info=build/info.plist --ignore=\"^/(dist|build/icon.iconset|build/icon-1024.png|\\.git)\"",
    "install-app": "npm run build && rm -rf \"/Applications/Knife Terminal.app\" && cp -R \"dist/Knife Terminal-darwin-arm64/Knife Terminal.app\" /Applications/ && echo installed",
    "build-helper": "swiftc -O -o bin/set-default build/set-default.swift"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^3.7.0",
    "electron": "^33.0.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  }
}
